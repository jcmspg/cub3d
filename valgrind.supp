# Suppressions for X11/XCB/minilibx false positives
{
   x11_xcb_writev
   Memcheck:Param
   writev(vector[...])
   ...
   fun:_xcb_conn_wait*
   ...
}

{
   x11_xcb_send
   Memcheck:Param
   writev(vector[...])
   ...
   fun:_XSend
   ...
}

{
   mlx_new_window
   Memcheck:Param
   writev(vector[...])
   ...
   fun:mlx_new_window
   ...
}

{
   mlx_init_display
   Memcheck:Param
   writev(vector[...])
   ...
   fun:XOpenDisplay
   ...
}

{
   mlx_anti_resize_uninit_writev
   Memcheck:Param
   writev(vector[0])
   fun:writev
   fun:*
   fun:*
   fun:xcb_writev
   fun:_XSend
   fun:_XReadEvents
   fun:XWindowEvent
   fun:mlx_int_wait_first_expose
   fun:mlx_new_window
   fun:mylx_create_window
   fun:init_game_window
}
